# =============================================================
# .env 파일 템플릿 — Git에 커밋되는 안전한 예시 파일
# =============================================================
# 실제 사용 시:
#   cp .env.example .env.development   (개발 설정 작성)
#   cp .env.example .env.production    (운영 설정 작성)
# 그 후 각 파일의 값을 환경에 맞게 수정하세요.

NODE_ENV=development

HEADLESS=false
CHROME_PROFILE_DIR=
DB_PATH=./data/wish_alert_dev.db
WISHLIST_URL=https://shopping.naver.com/my/wishes
ALERT_THRESHOLD_PCT=0

# 네이버 자동 로그인용 정보
NAVER_LOGIN_ID=
# NAVER_LOGIN_PASSWORD 에 # 문자가 들어가면 큰따옴표로 감싸세요.
# 예: NAVER_LOGIN_PASSWORD="abc#123"
NAVER_LOGIN_PASSWORD=
BOT_NAVIGATE=all
